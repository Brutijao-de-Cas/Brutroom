# Porta HTTP e WebSocket do servidor
PORT=3000
HOST=0.0.0.0

# STUN pode auxiliar a conexão direta; defina URL(s) separadas por vírgula.
STUN_URL=stun:stun.l.google.com:19302

# Preencha usando os dados do seu servidor TURN (ex.: coturn com REST habilitado).
# Mantenha o segredo somente no servidor; o app gera credenciais temporárias.
TURN_URL=turn:turn.example.com:3478
TURN_SHARED_SECRET=replace-with-a-server-side-secret
